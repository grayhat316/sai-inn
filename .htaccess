# Sai Inn .htaccess (Apache production: Render, cPanel)

Options -Indexes
DirectoryIndex index.html

# never serve these files
<FilesMatch "\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|db|md|json|lock|yaml|yml|sh|py|ini|toml|bak|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|Makefile|Procfile|docker-compose\.yml|composer\.json|package\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # never serve dotfiles, the data folder or the content snapshot
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule ^(data|seed|tests)/ - [F]
  # internal helper files are not entry points
  RewriteRule ^api/(secrets\.php|db\.php|config\.php|helpers\.php)$ - [F]
  # no PHP execution inside uploads
  RewriteRule ^uploads/.*\.php$ - [F]
  # clean URLs: /rooms serves rooms.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^([a-z0-9\-]+)/?$ $1.html [L,QSA]
</IfModule>

# security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-XSS-Protection "1; mode=block"
  # browsers only ever reach this site over https
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTP:X-Forwarded-Proto} == 'https' || %{HTTPS} == 'on'"
  # the admin panel is never cached or embedded
  Header set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#^/admin/#"
</IfModule>

# php settings
<IfModule mod_php.c>
  php_flag display_errors off
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
